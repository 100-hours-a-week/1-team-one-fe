{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "download:webgazer-models": "node ./scripts/download-webgazer-models.mjs",
    "generate:firebase-sw": "node ./scripts/generate-firebase-sw.mjs",
    "predev": "pnpm run generate:firebase-sw",
    "dev": "next dev --webpack",
    "predev:https": "pnpm run generate:firebase-sw",
    "dev:https": "next dev --experimental-https --webpack",
    "predev:turbo": "pnpm run generate:firebase-sw",
    "dev:turbo": "next dev",
    "prebuild": "pnpm run generate:firebase-sw && pnpm run download:webgazer-models",
    "build": "next build --webpack",
    "prestart": "pnpm run generate:firebase-sw",
    "start": "next start",
    "analyze": "ANALYZE=true pnpm run build",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@repo/eye-stretching-session": "workspace:*",
    "@repo/stretching-accuracy": "workspace:*",
    "@repo/stretching-session": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.8.0",
    "lucide-react": "0.575.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.71.1",
    "redis": "5.11.0",
    "webgazer": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@next/bundle-analyzer": "16.1.6",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/react-query-devtools": "5.91.2",
    "@tooling/eslint-config": "workspace:*",
    "@tooling/jest-config": "workspace:*",
    "@tooling/sentry-config": "workspace:*",
    "@tooling/typescript-config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "jest": "30.1.2",
    "jest-environment-jsdom": "30.1.2",
    "tailwindcss": "4.1.18"
  }
}
