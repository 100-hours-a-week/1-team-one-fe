{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.mjs"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --pretty false",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tooling/eslint-config": "workspace:*",
    "@tooling/typescript-config": "workspace:*",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "eslint": "9.39.2",
    "tailwind-merge": "^3.4.0",
    "tsup": "8.5.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "lucide-react": "0.575.0",
    "radix-ui": "^1.4.2",
    "sonner": "^1.7.4"
  }
}
