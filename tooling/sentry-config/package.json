{
  "name": "@tooling/sentry-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --pretty false",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@sentry/nextjs": "^10.38.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.2"
  }
}
